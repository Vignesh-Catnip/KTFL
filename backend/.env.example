DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/miro_invoice
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

EXTRACTION_MODE=demo

# Base Ollama URL only - do NOT include /api/generate, the app appends it automatically
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:11b
OLLAMA_TIMEOUT=180
OLLAMA_MAX_PAGES=3

RPA_MODE=mock

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
